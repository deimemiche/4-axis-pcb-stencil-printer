# Ignore common CAD output file formats
*.3mf
*.stl
*.step

# FreeCAD leaves one of these beside every document it saves
*.FCBak

# And some resin printing-related file formats.
*.ctb
*.lys

# The output directory
output/

# Backups
*~

# Python
venv/
__pycache__
dist/

# Written only by `rebuild.py assemble --calibrate`, and only so that
# calibrate-from-build.py can read the frames that run used.  Regenerated every
# time; the offsets it produces are what is committed.
cad/freecad-scripted/data/frames.json
cad/freecad-scripted/data/_tmp/
